APP_NAME=Sengonis
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

DB_CONNECTION=sqlite
# PostgreSQL: set DB_CONNECTION=pgsql and uncomment the values below
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=sengonis
# DB_USERNAME=postgres
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Lokasi kebun default untuk data demo (bukan lokasi otomatis pengguna)
KEBUN_LATITUDE=-8.14
KEBUN_LONGITUDE=113.718
BIAYA_POHON_MATI=45000
AMBANG_HUJAN_MM=60
AMBANG_PANAS_C=33
